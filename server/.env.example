# ---- Server (copy to server/.env for local dev, or to ./.env for docker compose) ----
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed browser origins (your frontend URL)
CLIENT_ORIGIN=https://your-domain.com
# Redis (docker compose sets this automatically to redis://redis:6379)
REDIS_URL=redis://localhost:6379

# LiveKit Cloud: https://cloud.livekit.io -> create project -> Settings -> Keys
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Set to false in production so a missing LiveKit config fails loudly instead of "demo mode"
ALLOW_MOCK_MEDIA=false

# Long random string; enables DELETE /api/admin/sessions/:id (moderation). Leave empty to disable.
ADMIN_TOKEN=
ROOM_CAPACITY=100
GRACE_SECONDS=45
JOIN_RATE_LIMIT_PER_MIN=10

# Your domain (used by Caddy/nginx examples in README)
DOMAIN=your-domain.com
